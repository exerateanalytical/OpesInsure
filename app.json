{
    "expo": {
        "name": "OpesInsure",
        "slug": "opesinsure",
        "version": "1.5.0",
        "orientation": "portrait",
        "scheme": "opesinsure",
        "userInterfaceStyle": "light",
        "newArchEnabled": true,
        "ios": {
            "supportsTablet": false,
            "bundleIdentifier": "com.opesware.opesinsure",
            "associatedDomains": [
                "applinks:insurance.opesdatacenter.tech"
            ],
            "infoPlist": {
                "ITSAppUsesNonExemptEncryption": false,
                "NSFaceIDUsageDescription": "Use Face ID to protect insurance and financial information."
            }
        },
        "android": {
            "package": "com.opesware.opesinsure",
            "adaptiveIcon": {
                "backgroundColor": "#071A2B",
                "foregroundImage": "./assets/adaptive-icon.png"
            },
            "edgeToEdgeEnabled": true,
            "intentFilters": [
                {
                    "action": "VIEW",
                    "autoVerify": true,
                    "data": [
                        {
                            "scheme": "https",
                            "host": "insurance.opesdatacenter.tech",
                            "pathPrefix": "/app"
                        }
                    ],
                    "category": [
                        "BROWSABLE",
                        "DEFAULT"
                    ]
                },
                {
                    "action": "VIEW",
                    "autoVerify": false,
                    "data": [
                        {
                            "scheme": "https",
                            "host": "insurance.opesdatacenter.tech",
                            "path": "/verify"
                        }
                    ],
                    "category": [
                        "BROWSABLE",
                        "DEFAULT"
                    ]
                }
            ],
            "permissions": [
                "android.permission.RECORD_AUDIO",
                "android.permission.USE_BIOMETRIC"
            ],
            "blockedPermissions": [
                "android.permission.SYSTEM_ALERT_WINDOW",
                "android.permission.DOWNLOAD_WITHOUT_NOTIFICATION",
                "android.permission.WRITE_EXTERNAL_STORAGE",
                "android.permission.RECEIVE_BOOT_COMPLETED",
                "android.permission.READ_APP_BADGE",
                "com.anddoes.launcher.permission.UPDATE_COUNT",
                "com.htc.launcher.permission.READ_SETTINGS",
                "com.htc.launcher.permission.UPDATE_SHORTCUT",
                "com.huawei.android.launcher.permission.CHANGE_BADGE",
                "com.huawei.android.launcher.permission.READ_SETTINGS",
                "com.huawei.android.launcher.permission.WRITE_SETTINGS",
                "com.majeur.launcher.permission.UPDATE_BADGE",
                "com.oppo.launcher.permission.READ_SETTINGS",
                "com.oppo.launcher.permission.WRITE_SETTINGS",
                "com.sec.android.provider.badge.permission.READ",
                "com.sec.android.provider.badge.permission.WRITE",
                "com.sonyericsson.home.permission.BROADCAST_BADGE",
                "com.sonymobile.home.permission.PROVIDER_INSERT_BADGE",
                "me.everything.badger.permission.BADGE_COUNT_READ",
                "me.everything.badger.permission.BADGE_COUNT_WRITE"
            ]
        },
        "plugins": [
            "expo-router",
            "react-native-blob-util",
            [
                "expo-splash-screen",
                {
                    "backgroundColor": "#FFFFFF",
                    "image": "./assets/icon.png",
                    "imageWidth": 160,
                    "resizeMode": "contain",
                    "dark": {
                        "backgroundColor": "#FFFFFF",
                        "image": "./assets/icon.png"
                    }
                }
            ],
            "expo-secure-store",
            "expo-font",
            "expo-localization",
            "expo-notifications",
            [
                "expo-image-picker",
                {
                    "cameraPermission": "Allow OpesInsure to capture claim evidence and KYC photos. / Autorisez OpesInsure à prendre des photos pour vos sinistres et votre KYC.",
                    "microphonePermission": "Allow OpesInsure to record audio with claim videos. / Autorisez OpesInsure à enregistrer le son des vidéos de sinistre.",
                    "photosPermission": "Allow OpesInsure to attach photos and videos to your claims and KYC. / Autorisez OpesInsure à joindre des photos et vidéos à vos sinistres et à votre KYC."
                }
            ],
            [
                "expo-location",
                {
                    "locationWhenInUsePermission": "OpesInsure uses your location only while you fill a form, to prefill your town and region (and the incident position on a claim). / OpesInsure utilise votre position uniquement pendant la saisie d'un formulaire, pour préremplir votre ville et votre région (et la position du sinistre).",
                    "isAndroidBackgroundLocationEnabled": false,
                    "isIosBackgroundLocationEnabled": false
                }
            ],
            "expo-document-picker",
            "expo-local-authentication",
            [
                "expo-build-properties",
                {
                    "android": {
                        "buildArchs": [
                            "arm64-v8a",
                            "armeabi-v7a"
                        ],
                        "enableProguardInReleaseBuilds": true,
                        "enableShrinkResourcesInReleaseBuilds": true,
                        "useLegacyPackaging": false,
                        "extraProguardRules": "-keep class com.shockwave.** { *; }\n-keep class com.github.barteksc.** { *; }\n-keep class com.ReactNativeBlobUtil.** { *; }"
                    }
                }
            ]
        ],
        "experiments": {
            "typedRoutes": true
        },
        "extra": {
            "eas": {
                "projectId": "257a3907-e58d-442b-914f-984d74c96767"
            }
        },
        "icon": "./assets/icon.png",
        "owner": "opeswares-team",
        "runtimeVersion": {
            "policy": "appVersion"
        },
        "updates": {
            "url": "https://u.expo.dev/257a3907-e58d-442b-914f-984d74c96767",
            "fallbackToCacheTimeout": 0,
            "checkAutomatically": "ON_LOAD",
            "codeSigningCertificate": "./certs/certificate.pem",
            "codeSigningMetadata": {
                "keyid": "main",
                "alg": "rsa-v1_5-sha256"
            }
        },
        "platforms": [
            "ios",
            "android",
            "web"
        ],
        "splash": {
            "image": "./assets/icon.png",
            "resizeMode": "contain",
            "backgroundColor": "#FFFFFF"
        },
        "jsEngine": "hermes"
    }
}
