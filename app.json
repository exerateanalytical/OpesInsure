{
    "expo": {
        "name": "OpesInsure",
        "slug": "opesinsure",
        "version": "1.4.0",
        "orientation": "portrait",
        "scheme": "opesinsure",
        "userInterfaceStyle": "light",
        "newArchEnabled": true,
        "ios": {
            "supportsTablet": false,
            "bundleIdentifier": "com.opesware.opesinsure",
            "associatedDomains": [
                "applinks:insurance.opesdatacenter.tech"
            ],
            "infoPlist": {
                "ITSAppUsesNonExemptEncryption": false,
                "NSFaceIDUsageDescription": "Use Face ID to protect insurance and financial information."
            }
        },
        "android": {
            "package": "com.opesware.opesinsure",
            "adaptiveIcon": {
                "backgroundColor": "#071A2B",
                "foregroundImage": "./assets/adaptive-icon.png"
            },
            "edgeToEdgeEnabled": true,
            "intentFilters": [
                {
                    "action": "VIEW",
                    "autoVerify": true,
                    "data": [
                        {
                            "scheme": "https",
                            "host": "insurance.opesdatacenter.tech",
                            "pathPrefix": "/app"
                        }
                    ],
                    "category": [
                        "BROWSABLE",
                        "DEFAULT"
                    ]
                },
                {
                    "action": "VIEW",
                    "autoVerify": false,
                    "data": [
                        {
                            "scheme": "https",
                            "host": "insurance.opesdatacenter.tech",
                            "path": "/verify"
                        }
                    ],
                    "category": [
                        "BROWSABLE",
                        "DEFAULT"
                    ]
                }
            ],
            "permissions": [
                "android.permission.RECORD_AUDIO",
                "android.permission.USE_BIOMETRIC"
            ]
        },
        "plugins": [
            "expo-router",
            "react-native-blob-util",
            [
                "expo-splash-screen",
                {
                    "backgroundColor": "#FFFFFF",
                    "image": "./assets/icon.png",
                    "imageWidth": 160,
                    "resizeMode": "contain",
                    "dark": {
                        "backgroundColor": "#FFFFFF",
                        "image": "./assets/icon.png"
                    }
                }
            ],
            "expo-secure-store",
            "expo-font",
            "expo-localization",
            "expo-notifications",
            [
                "expo-image-picker",
                {
                    "cameraPermission": "Allow OpesInsure to capture claim evidence.",
                    "microphonePermission": "Allow OpesInsure to record audio with claim videos.",
                    "photosPermission": "Allow OpesInsure to attach photos and videos to your claims and KYC."
                }
            ],
            [
                "expo-location",
                {
                    "locationWhenInUsePermission": "OpesInsure uses your location only while you fill a form, to prefill your town and region (and the incident position on a claim). / OpesInsure utilise votre position uniquement pendant la saisie d'un formulaire, pour préremplir votre ville et votre région (et la position du sinistre).",
                    "isAndroidBackgroundLocationEnabled": false,
                    "isIosBackgroundLocationEnabled": false
                }
            ],
            "expo-document-picker",
            "expo-local-authentication"
        ],
        "experiments": {
            "typedRoutes": true
        },
        "extra": {
            "apiBaseUrl": "${EXPO_PUBLIC_API_BASE_URL}",
            "eas": {
                "projectId": "257a3907-e58d-442b-914f-984d74c96767"
            }
        },
        "icon": "./assets/icon.png",
        "owner": "opeswares-team",
        "runtimeVersion": {
            "policy": "appVersion"
        },
        "updates": {
            "url": "https://u.expo.dev/257a3907-e58d-442b-914f-984d74c96767",
            "fallbackToCacheTimeout": 0,
            "checkAutomatically": "ON_LOAD"
        },
        "platforms": [
            "ios",
            "android",
            "web"
        ],
        "splash": {
            "image": "./assets/icon.png",
            "resizeMode": "contain",
            "backgroundColor": "#FFFFFF"
        }
    }
}
