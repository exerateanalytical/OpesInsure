{
    "cli": {
        "version": ">= 16.0.0",
        "appVersionSource": "remote"
    },
    "build": {
        "development": {
            "developmentClient": true,
            "distribution": "internal",
            "channel": "development",
            "env": {
                "EXPO_PUBLIC_APP_ENV": "demo",
                "EXPO_PUBLIC_RELEASE_CHANNEL": "development",
                "EXPO_PUBLIC_SHOW_DEMO_LOGIN": "true",
                "EXPO_PUBLIC_API_BASE_URL": "https://insurance.opesdatacenter.tech/api/v1"
            }
        },
        "preview": {
            "distribution": "internal",
            "channel": "preview",
            "env": {
                "EXPO_PUBLIC_APP_ENV": "staging",
                "EXPO_PUBLIC_RELEASE_CHANNEL": "preview",
                "EXPO_PUBLIC_SHOW_DEMO_LOGIN": "false",
                "EXPO_PUBLIC_API_BASE_URL": "https://insurance.opesdatacenter.tech/api/v1"
            }
        },
        "production": {
            "autoIncrement": true,
            "channel": "production",
            "env": {
                "EXPO_PUBLIC_APP_ENV": "production",
                "EXPO_PUBLIC_RELEASE_CHANNEL": "production",
                "EXPO_PUBLIC_SHOW_DEMO_LOGIN": "false",
                "EXPO_PUBLIC_API_BASE_URL": "https://insurance.opesdatacenter.tech/api/v1"
            },
            "android": {
                "buildType": "app-bundle"
            }
        },
        "production-apk": {
            "extends": "production",
            "distribution": "internal",
            "env": {
                "EXPO_PUBLIC_APP_ENV": "production",
                "EXPO_PUBLIC_RELEASE_CHANNEL": "production",
                "EXPO_PUBLIC_SHOW_DEMO_LOGIN": "true",
                "EXPO_PUBLIC_API_BASE_URL": "https://insurance.opesdatacenter.tech/api/v1"
            },
            "android": {
                "buildType": "apk"
            },
            "channel": "production-apk"
        },
        "demo-apk": {
            "distribution": "internal",
            "channel": "demo",
            "android": {
                "buildType": "apk"
            },
            "env": {
                "EXPO_PUBLIC_APP_ENV": "demo",
                "EXPO_PUBLIC_RELEASE_CHANNEL": "demo",
                "EXPO_PUBLIC_SHOW_DEMO_LOGIN": "true",
                "EXPO_PUBLIC_API_BASE_URL": "https://insurance.opesdatacenter.tech/api/v1"
            }
        }
    },
    "submit": {
        "production": {
            "android": {
                "track": "internal",
                "releaseStatus": "draft",
                "serviceAccountKeyPath": "./credentials/google-play-service-account.json"
            },
            "ios": {
                "appleTeamId": "SET_APPLE_TEAM_ID",
                "ascAppId": "SET_ASC_APP_ID"
            }
        }
    }
}
