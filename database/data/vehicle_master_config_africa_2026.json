{
  "catalogue": {
    "name": "OpesInsure Cameroon & Africa Core Vehicle Master",
    "version": "1.0.0",
    "market": [
      "CM",
      "CEMAC",
      "AFRICA"
    ],
    "default_country": "CM",
    "selection_flow": [
      "make",
      "model",
      "generation",
      "model_year",
      "engine_variant"
    ],
    "auto_populate_from_engine_variant": [
      "power_hp",
      "power_kw",
      "displacement_cc",
      "fuel_type",
      "transmission",
      "drivetrain",
      "body_type",
      "torque_nm"
    ],
    "manual_entry_policy": {
      "enabled": true,
      "show_only_when_not_found": true,
      "manual_record_status": "PENDING_MASTER_REVIEW",
      "auto_publish_to_master": false,
      "duplicate_check_required": true,
      "allowed_manual_fields": [
        "make",
        "model",
        "model_year",
        "generation",
        "engine_label",
        "power_hp",
        "displacement_cc",
        "fuel_type",
        "transmission",
        "drivetrain",
        "body_type"
      ]
    },
    "source_priority": [
      "OPESINSURE_VERIFIED_OVERRIDE",
      "CAMEROON_DISTRIBUTOR_VERIFIED",
      "GLOBAL_VEHICLE_DATASET",
      "MANUAL_PENDING_REVIEW"
    ],
    "global_vehicle_dataset": {
      "repository": "gor3a/vehicle-makes-models",
      "import_mode": "FILTER_BY_CORE_MAKES_AND_MODELS",
      "import_generations": true,
      "import_engines": true,
      "import_year_ranges": true,
      "import_horsepower": true,
      "import_torque": true,
      "import_transmission": true,
      "import_drivetrain": true,
      "import_body_type": true
    },
    "storage_policy": {
      "store_vehicle_master_once": true,
      "transaction_records_store_foreign_keys": true,
      "policy_issue_snapshot_required": true,
      "do_not_duplicate_make_model_specs_per_customer": true
    }
  },
