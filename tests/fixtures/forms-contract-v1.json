    "other_allowed": true,
    "input": "picker",
    "allow_other": true
   },
   {
    "step": "address",
    "key": "city",
    "label": "City / town",
    "label_en": "City / town",
    "label_fr": "Ville",
    "type": "select_master",
    "required": false,
    "parent_field": "department",
    "source": {
     "domain": "geography",
     "list": "city",
     "parent": "department",
     "parent_code": null
    },
    "other_allowed": true,
    "input": "picker",
    "allow_other": true
   },
   {
    "step": "address",
    "key": "address_line1",
    "label": "Street / landmark",
    "label_en": "Street / landmark",
    "label_fr": "Rue / repère",
