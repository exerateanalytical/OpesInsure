    "expo-document-picker": "~14.0.8",
    "expo-font": "~14.0.0",
    "expo-haptics": "~15.0.0",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.0",
    "expo-linking": "~8.0.0",
