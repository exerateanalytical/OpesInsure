    "required": false,
    "max_length": 255,
    "input": "text",
    "free_text": {
     "reason": "LANDMARK"
    }
   },
   {
    "step": "beneficiaries",
    "key": "beneficiaries",
    "label": "Beneficiaries",
    "label_en": "Beneficiaries",
    "label_fr": "Bénéficiaires",
    "type": "repeater",
    "required": false,
    "max_items": 10,
    "allocation": {
     "field": "share_percent",
     "total": 100
    },
    "item_fields": [
     {
      "key": "name",
      "label": "Full name",
      "label_en": "Full name",
      "label_fr": "Nom complet",
      "type": "text",
      "required": true,
      "max_length": 160,
      "input": "text",
      "free_text": {
       "reason": "PERSON_NAME"
      }
     },
     {
      "key": "relationship",
      "label": "Relationship",
      "label_en": "Relationship",
      "label_fr": "Lien de parenté",
      "type": "select_master",
      "required": true,
      "source": {
       "domain": "persons",
       "list": "relationship",
       "parent": null,
       "parent_code": null
      },
      "other_allowed": true,
      "input": "picker",
      "allow_other": true
     },
     {
      "key": "share_percent",
      "label": "Share (%)",
      "label_en": "Share (%)",
      "label_fr": "Quote-part (%)",
      "type": "number",
      "required": true,
      "min": 0.01,
      "max": 100,
      "input": "number"
     }
    ],
    "input": "repeater"
   }
  ],
  "contract": 1
 },
